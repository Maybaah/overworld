# Copy this file to .env and fill in the values. Never commit .env.

# IGDB (via Twitch). Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# MobyGames API key. https://www.mobygames.com/info/api/
# Optional: the pipeline skips MobyGames when this is empty.
MOBYGAMES_API_KEY=

# Steam Web API key (Phase 3, "My globe"). https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Free key from https://rawg.io/apidocs; adds console and older games to the player estimate.
RAWG_API_KEY=

# Contact string sent in the User-Agent to Wikidata, as their policy asks.
# Example: overworld-pipeline (https://github.com/you/overworld)
WIKIDATA_USER_AGENT_CONTACT=

# Usage stats (optional, docs/SELF-HOSTING.md). Only scripts/supabase.mjs reads these two.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# Build-time values for the app and /admin.html go in web/.env.local, not here:
# VITE_EVENTS_URL, VITE_TELEMETRY_HOSTS, VITE_SUPABASE_URL, VITE_SUPABASE_PUBLISHABLE_KEY.
