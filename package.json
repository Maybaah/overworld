{
  "name": "overworld",
  "description": "A 3D globe that shows where video games were made",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:real": "npm run dev:real -w web",
    "build": "npm run build -w web",
    "deploy": "npm run build && wrangler deploy",
    "dev:worker": "wrangler dev",
    "test": "npm run test:pipeline && npm run test:web",
    "test:pipeline": "vitest run",
    "test:web": "npm test -w web",
    "typecheck": "tsc --noEmit && tsc -b web",
    "pipeline": "tsx pipeline/src/run.ts",
    "validate": "tsx pipeline/src/validate.ts",
    "fixture": "tsx pipeline/src/fixture.ts",
    "sprites": "tsx web/scripts/cover-sprites.ts",
    "layouts": "tsx web/scripts/mosaic-layouts.ts",
    "supabase": "node scripts/supabase.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@types/node": "^22.0.0",
    "all-the-cities": "^3.1.0",
    "dotenv": "^16.4.5",
    "sharp": "^0.34.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "world-countries": "^5.0.0",
    "wrangler": "^4.157.0"
  }
}
