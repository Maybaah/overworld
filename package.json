  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "all-the-cities": "^3.1.0",
    "dotenv": "^16.4.5",
    "sharp": "^0.34.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "world-countries": "^5.0.0"
  }
}
